{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Long-lived caching for hashed Next.js assets
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	header -Server
	reverse_proxy app:3000
}

# Redirect www -> apex
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Self-hosted Umami (only reachable when the "analytics" profile is up)
{$STATS_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
