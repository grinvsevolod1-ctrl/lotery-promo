# Скопируйте в .env и заполните значения.
# Next.js, drizzle-kit, PM2 и docker compose читают .env автоматически.

# ---------- База данных ----------
# PM2-вариант: PostgreSQL на самом VPS.
# В docker compose эта переменная подставляется автоматически (см. POSTGRES_PASSWORD ниже).
DATABASE_URL=postgres://lotery:CHANGE_ME@127.0.0.1:5432/lotery

# ---------- Адрес сайта ----------
# С https://, без завершающего слэша
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=lotery.by

# Секрет для подписи сессий: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Дополнительные доверенные origin'ы через запятую (например, www-домен)
TRUSTED_ORIGINS=

# IP/CIDR обратных прокси, чьим заголовкам X-Forwarded-For/X-Real-IP можно верить.
# PM2 + nginx на том же сервере: 127.0.0.1,::1 (значение по умолчанию).
# docker compose подставляет диапазон своей сети сам.
TRUSTED_PROXIES=

# ---------- Почта (подтверждение e-mail, сброс пароля, результаты тиражей) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="lotery.by <no-reply@example.com>"
# Альтернатива SMTP (например, на Vercel): ключ Resend. Используется, когда
# SMTP_HOST пуст. Без подтверждённого домена MAIL_FROM должен быть пустым
# (отправитель onboarding@resend.dev), а письма доходят только на e-mail
# владельца аккаунта Resend.
RESEND_API_KEY=
# Тестовый режим почты: письма никуда не отправляются, а ссылка из письма
# показывается прямо на странице после регистрации / запроса. Только для
# тестовых стендов без почтового провайдера — на публичном сайте не включать.
MAIL_TEST_MODE=
# 1 = требовать подтверждение e-mail при регистрации. Пусто = вход сразу после регистрации.
REQUIRE_EMAIL_VERIFICATION=

# ---------- Защита от ботов (Cloudflare Turnstile, бесплатно) ----------
# Пусто = проверка выключена. Ключи: https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Розыгрыши ----------
# Билеты разыгрываются мгновенно при покупке, планировщик не нужен.
# GET /api/cron/settle (заголовок Authorization: Bearer <CRON_SECRET>) только
# доигрывает старые билеты из ежедневных тиражей. Пусто = эндпоинт отключён.
CRON_SECRET=

# ---------- Аналитика (Umami, опционально) ----------
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ---------- Реквизиты организатора (футер, правила, оферта, контакты) ----------
NEXT_PUBLIC_OPERATOR_NAME="ООО «Лотери Промо»"
NEXT_PUBLIC_OPERATOR_UNP=000000000
NEXT_PUBLIC_OPERATOR_ADDRESS="Республика Беларусь, г. Минск"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE="+375 (29) 000-00-00"
NEXT_PUBLIC_SUPPORT_HOURS="ежедневно с 9:00 до 21:00"
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_VK_URL=

# ---------- Только для PM2 ----------
# Порт, на котором слушает next start (nginx проксирует на него)
PORT=3000

# ---------- Только для docker compose ----------
# Пароль Postgres в контейнере (DATABASE_URL собирается из него автоматически)
POSTGRES_PASSWORD=CHANGE_ME
# Домен для Caddy (сертификат Let's Encrypt выпускается автоматически)
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
# Поддомен для Umami (профиль analytics); пусто = не используется
STATS_DOMAIN=
# openssl rand -hex 32
UMAMI_APP_SECRET=
# Сколько дней хранить ежедневные дампы в ./backups
BACKUP_KEEP_DAYS=14
