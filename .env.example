# Скопируйте в .env на VPS и заполните значения.
# Next.js, drizzle-kit и PM2 читают .env автоматически.

# PostgreSQL на VPS
DATABASE_URL=postgres://lotery:CHANGE_ME@127.0.0.1:5432/lotery

# Публичный адрес сайта: с https://, без завершающего слэша
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=lotery.by

# Секрет для подписи сессий: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Дополнительные доверенные origin'ы через запятую (например, www-домен)
TRUSTED_ORIGINS=

# SMTP для писем подтверждения e-mail и смены пароля
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="lotery.by <no-reply@example.com>"

# Порт, на котором слушает next start (nginx проксирует на него)
PORT=3000
